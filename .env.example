REEPAY_PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reepay?schema=public
REDIS_URL=redis://localhost:6379
REEPAY_API_KEY=replace-with-public-api-key
REEPAY_ALLOWED_APPLICATION_IDS=sangapay-backend
REEPAY_ENV=sandbox

REEPAY_FEE_TYPE=fixed
REEPAY_FEE_FIXED=0
REEPAY_FEE_PERCENT=0
REEPAY_FEE_PERCENT_CAP=
REEPAY_FEE_CURRENCY=XAF
REEPAY_EUR_PAYOUT_FEE_FIXED=0
REEPAY_EUR_PAYOUT_FEE_PERCENT=0
REEPAY_EUR_PAYOUT_FEE_PERCENT_CAP=10
REEPAY_USDC_PAYOUT_FEE_FIXED=0
REEPAY_USDC_PAYOUT_FEE_PERCENT=0
REEPAY_USDC_PAYOUT_FEE_PERCENT_CAP=

REEPAY_RECONCILIATION_ENABLED=true
REEPAY_RECONCILIATION_INTERVAL_MS=300000
REEPAY_RECONCILIATION_LOOKBACK_MINUTES=1440
REEPAY_RECONCILIATION_BATCH_SIZE=25

SANGAPAY_WEBHOOK_ENABLED=false
SANGAPAY_WEBHOOK_URL=https://sangapay-backend.example.com/webhooks/reepay
SANGAPAY_WEBHOOK_SECRET=replace-in-secret-manager
SANGAPAY_WEBHOOK_MAX_ATTEMPTS=3
SANGAPAY_WEBHOOK_RETRY_BASE_DELAY_MS=500

KRYPTAPAY_BASE_URL=https://provider.example.invalid
KRYPTAPAY_API_KEY=replace-in-secret-manager
KRYPTAPAY_WEBHOOK_SECRET=replace-in-secret-manager
KRYPTAPAY_DEPOSIT_FEE_FALLBACK_ENABLED=true
KRYPTAPAY_DEPOSIT_FEE_PERCENT=2.5
KRYPTAPAY_BANK_PAYOUT_FEE_FALLBACK_ENABLED=true
KRYPTAPAY_BANK_PAYOUT_FEE_PERCENT=0.3

WISE_BASE_URL=https://api.wise.com
WISE_API_TOKEN=
WISE_PROFILE_ID=
WISE_EUR_BALANCE_ID=
WISE_WEBHOOK_PUBLIC_KEY=
WISE_EUR_FUNDING_IBAN=REPLACE_WITH_WISE_EUR_IBAN
WISE_EUR_FUNDING_ACCOUNT_NAME=REPLACE_WITH_WISE_ACCOUNT_NAME
WISE_EUR_FUNDING_BANK_NAME=Wise Europe SA
